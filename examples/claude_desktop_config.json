{
  "mcpServers": {
    "socialdatax-xhs": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.socialdatax.com/xhs/mcp",
        "--header",
        "Authorization: Bearer ${SOCIALDATAX_API_KEY}"
      ],
      "env": {
        "SOCIALDATAX_API_KEY": "<SOCIALDATAX_API_KEY>"
      }
    }
  }
}
